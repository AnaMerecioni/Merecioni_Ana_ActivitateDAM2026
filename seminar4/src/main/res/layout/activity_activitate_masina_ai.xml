<?xml version="1.0" encoding="utf-8"?>
<!-- Varianta de design realizata cu Inteligenta Artificiala -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ai_fundal"
    android:fillViewport="true"
    tools:context=".ActivitateMasinaAI">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- antet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ai_antet"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adauga_masina"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:text="@string/titlu_adaugare"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- card: date de baza -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="-16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/model">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/model_ET"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/marca"
                    android:textColor="@color/ai_text_secundar"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/marca_RG"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/dacia_RB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/ai_accent"
                        android:checked="true"
                        android:text="Dacia" />

                    <RadioButton
                        android:id="@+id/bmw_RB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/ai_accent"
                        android:text="BMW" />

                    <RadioButton
                        android:id="@+id/toyota_RB"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="@color/ai_accent"
                        android:text="Toyota" />
                </RadioGroup>

                <CheckBox
                    android:id="@+id/esteNoua_CB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/ai_accent"
                    android:text="@string/este_noua" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- card: detalii -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/combustibil"
                    android:textColor="@color/ai_text_secundar"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/combustibil_SP"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:entries="@array/tipuri_combustibil" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/nota"
                    android:textColor="@color/ai_text_secundar"
                    android:textStyle="bold" />

                <RatingBar
                    android:id="@+id/nota_RB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:numStars="5"
                    android:progressTint="@color/ai_accent"
                    android:stepSize="0.5" />

                <Switch
                    android:id="@+id/aer_SW"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/aer_conditionat"
                    android:textSize="16sp"
                    android:thumbTint="@color/ai_accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/ai_accent"
            android:onClick="salveazaMasina"
            android:text="@string/salveaza"
            android:textSize="16sp"
            app:cornerRadius="16dp" />
    </LinearLayout>
</ScrollView>
