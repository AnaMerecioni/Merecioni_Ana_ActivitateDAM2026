<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World!" />

    <EditText
        android:id="@+id/id_nume_ET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Introduceti numele"
        android:inputType="text" />

    <CheckBox
        android:id="@+id/eStudent_CB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Esti student" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hello world" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="deschideAdaugare"
        android:text="@string/adauga_masina" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="deschideAdaugareAI"
        android:text="@string/adauga_masina_ai" />

    <TextView
        android:id="@+id/masina_TV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/nicio_masina" />

</LinearLayout>